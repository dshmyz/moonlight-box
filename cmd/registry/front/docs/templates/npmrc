# NPM 配置文件模板
# 将此文件复制到 ~/.npmrc 或项目根目录

# 仓库地址
registry=https://your-moonlight-domain/repository/npm-virtual/

# 认证信息 - 使用 Token 认证（推荐）
//your-moonlight-domain/repository/npm-virtual/:_authToken=YOUR_TOKEN_HERE

# 或者使用 Basic 认证
# //your-moonlight-domain/repository/npm-virtual/:username=YOUR_USERNAME
# //your-moonlight-domain/repository/npm-virtual/:_password=YOUR_BASE64_PASSWORD

# 作用域包配置（可选）
# @mycompany:registry=https://your-moonlight-domain/repository/npm-local/

# 代理配置（可选）
# proxy=http://proxy.company.com:8080
# https-proxy=http://proxy.company.com:8080

# 缓存配置（可选）
# cache=~/.npm-cache

# 其他配置
# strict-ssl=false
# always-auth=true
