<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 包源配置 -->
  <packageSources>
    <clear />
    
    <!-- Moonlight 仓库 -->
    <add key="moonlight" value="http://your-registry:9081/nuget/v3/index.json" />
    
    <!-- 官方 NuGet 仓库（可选） -->
    <!-- <add key="nuget.org" value="https://api.nuget.org/v3/index.json" /> -->
  </packageSources>
  
  <!-- 包源认证 -->
  <packageSourceCredentials>
    <moonlight>
      <add key="Username" value="YOUR_USERNAME" />
      <add key="ClearTextPassword" value="YOUR_PASSWORD" />
      <!-- 或使用加密密码 -->
      <!-- <add key="Password" value="YOUR_ENCRYPTED_PASSWORD" /> -->
    </moonlight>
  </packageSourceCredentials>
  
  <!-- API Key 配置（用于发布） -->
  <apikeys>
    <add key="http://your-registry:9081/nuget/v3/index.json" value="YOUR_API_KEY" />
  </apikeys>
  
  <!-- 包安装配置 -->
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
  
  <!-- 绑定重定向 -->
  <bindingRedirects>
    <add key="skip" value="False" />
  </bindingRedirects>
  
  <!-- 包管理格式 -->
  <packageManagement>
    <add key="format" value="PackageReference" />
  </packageManagement>
</configuration>
