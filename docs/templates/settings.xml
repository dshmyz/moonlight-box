<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">
  
  <!-- 本地仓库路径 -->
  <localRepository>~/.m2/repository</localRepository>
  
  <!-- 服务器认证配置 -->
  <servers>
    <!-- 发布 Release 包 -->
    <server>
      <id>moonlight-releases</id>
      <username>YOUR_USERNAME</username>
      <password>YOUR_PASSWORD</password>
    </server>
    
    <!-- 发布 Snapshot 包 -->
    <server>
      <id>moonlight-snapshots</id>
      <username>YOUR_USERNAME</username>
      <password>YOUR_PASSWORD</password>
    </server>
    
    <!-- 代理仓库认证（如果需要） -->
    <server>
      <id>moonlight-proxy</id>
      <username>YOUR_USERNAME</username>
      <password>YOUR_PASSWORD</password>
    </server>
  </servers>

  <!-- 镜像配置 -->
  <mirrors>
    <!-- 将 Maven Central 重定向到 Moonlight -->
    <mirror>
      <id>moonlight-public</id>
      <mirrorOf>central</mirrorOf>
      <name>Moonlight Public Repository</name>
      <url>http://your-registry:9081/repo/maven-virtual/</url>
    </mirror>
    
    <!-- 可选：镜像所有外部仓库 -->
    <!--
    <mirror>
      <id>moonlight-all</id>
      <mirrorOf>external:*</mirrorOf>
      <name>Moonlight All External Repositories</name>
      <url>http://your-registry:9081/repo/maven-virtual/</url>
    </mirror>
    -->
  </mirrors>

  <!-- Profile 配置 -->
  <profiles>
    <profile>
      <id>moonlight</id>
      
      <!-- 仓库配置 -->
      <repositories>
        <!-- 本地仓库 -->
        <repository>
          <id>moonlight-releases</id>
          <name>Moonlight Releases</name>
          <url>http://your-registry:9081/repo/maven-local/</url>
          <releases>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        
        <!-- Snapshot 仓库 -->
        <repository>
          <id>moonlight-snapshots</id>
          <name>Moonlight Snapshots</name>
          <url>http://your-registry:9081/repo/maven-local/</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
        </repository>
        
        <!-- 虚拟仓库（聚合本地和代理） -->
        <repository>
          <id>moonlight-virtual</id>
          <name>Moonlight Virtual Repository</name>
          <url>http://your-registry:9081/repo/maven-virtual/</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
        </repository>
      </repositories>
      
      <!-- 插件仓库 -->
      <pluginRepositories>
        <pluginRepository>
          <id>moonlight-plugins</id>
          <name>Moonlight Plugins</name>
          <url>http://your-registry:9081/repo/maven-virtual/</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <!-- 激活 Profile -->
  <activeProfiles>
    <activeProfile>moonlight</activeProfile>
  </activeProfiles>
</settings>
